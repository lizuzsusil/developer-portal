# Types package published to npm - used across docs and landing page.
# Override when the package is renamed (e.g. @sewa/mini-app-types).
# All code samples and install commands read this at build time via docusaurus.config.ts customFields.
TYPES_PACKAGE=@lizuz/mini-app-types

# Alternative aliases also supported:
# SEWA_TYPES_PACKAGE=@sewa/mini-app-types
# MINI_APP_TYPES_PACKAGE=@sewa/mini-app-types
