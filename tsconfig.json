{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"],
      "@sewa/design-tokens": ["./packages/design-tokens/tokens.css"],
      "@sewa/design-tokens/*": ["./packages/design-tokens/*"],
      "@sewa/sdk-playground": ["./packages/sdk-playground/src"],
      "@sewa/sdk-playground/*": ["./packages/sdk-playground/src/*"],
      "@sewa/host-playground/*": ["./packages/host-playground/src/*"],
      "@sewa/framework-react": ["./packages/framework-react/src"],
      "@sewa/framework-react/*": ["./packages/framework-react/src/*"],
      "@sewa/framework-vue": ["./packages/framework-vue/src"],
      "@sewa/framework-vue/*": ["./packages/framework-vue/src/*"],
      "@sewa/framework-angular": ["./packages/framework-angular/src"],
      "@sewa/framework-angular/*": ["./packages/framework-angular/src/*"]
    },
    "skipLibCheck": true,
    "strict": true
  },
  "exclude": [".docusaurus", "build", "node_modules"]
}
